}

#api call for creating token
###
POST http://127.0.0.1:8000/accounts/token/
Content-Type: application/json

{
    "username":"7034111096",
    "password":"password@123"
}

#api call for fetching current user
###
GET http://127.0.0.1:8000/accounts/user/
Accept: application/json
Authorization: Token 33a8c8248cc6b589b4698fca283f528055b508a3

#api call for listing todo
###
GET  http://127.0.0.1:8000/todo/?page=2
Accept: application/json
Authorization: Token 33a8c8248cc6b589b4698fca283f528055b508a3

#api call for creating todo
###
POST http://127.0.0.1:8000/todo/
Content-Type: application/json
Authorization: Token 33a8c8248cc6b589b4698fca283f528055b508a3

{
    "title":"learn sql joins",
    "status":"pending"
    
}

#api call for retrieving todo
###
GET http://127.0.0.1:8000/todo/1/
Accept: application/json
Authorization: Token 33a8c8248cc6b589b4698fca283f528055b508a3

#api call for updating todo
###
PUT http://127.0.0.1:8000/todo/1/
Content-Type: application/json
